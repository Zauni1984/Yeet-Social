# Yeet Environment — Copy to .env and fill in values

DATABASE_URL=postgres://yeet:CHANGE_ME@localhost:5432/yeet
POSTGRES_PASSWORD=CHANGE_ME

REDIS_URL=redis://localhost:6379

# openssl rand -hex 64
JWT_SECRET=CHANGE_ME

# Target chain — keep in lock-step with the frontend window.YEET_CHAIN.
# 56 = BSC Mainnet (default), 97 = BSC Testnet.
YEET_CHAIN_ID=56
# BSC Mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org/
# BSC Testnet
# BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Deployed YEET contract addresses on the chain above. Must match the
# frontend window.YEET_CHAIN.token / contract configs.
YEET_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
YEET_NFT_ADDRESS=0x0000000000000000000000000000000000000000
YEET_PAYMENTS_ADDRESS=0x0000000000000000000000000000000000000000
YEET_PAPER_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Backend hot wallet — NEVER commit!
REWARDS_MINTER_PRIVKEY=

# Email (double opt-in verification). If unset, no verification mail is sent.
# SMTP_PORT 587 → STARTTLS (default), 465 → implicit TLS. Override with
# SMTP_STARTTLS=true/false if your provider differs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_STARTTLS=true
PUBLIC_BASE_URL=https://justyeet.it
# Admin secret for the transaction ledger API — set a STRONG value in prod.
ADMIN_SECRET=CHANGE_ME

PORT=8080
RUST_LOG=backend=info,tower_http=info

API_URL=http://localhost:8080/api/v1

# --- Post translation (optional) ---
# TRANSLATE_PROVIDER=azure | google | deepl | libretranslate   (unset = disabled; UI hides the button)
# TRANSLATE_URL=      optional override (defaults per provider; LibreTranslate: http://libretranslate:5000)
# TRANSLATE_API_KEY=  required for azure/google/deepl, optional for LibreTranslate
# TRANSLATE_REGION=   Azure resource region, e.g. germanywestcentral / westeurope
TRANSLATE_PROVIDER=
TRANSLATE_URL=
TRANSLATE_API_KEY=
TRANSLATE_REGION=
