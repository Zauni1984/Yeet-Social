# VPS .env  copy to /root/yeet-social/.env on the VPS, fill, chmod 600.
# Loaded by docker-compose.yml AND vps/start_backend.sh.
# NEVER commit a filled-in version of this file.

# Postgres password for the `yeet` user
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing secret  generate with:  openssl rand -hex 64
# Rotating this invalidates all current user sessions.
JWT_SECRET=CHANGE_ME

# Admin endpoint secret (used by /api/v1/admin/*)
ADMIN_SECRET=CHANGE_ME

# Optional log level
RUST_LOG=backend=info,tower_http=warn

# SMTP (GDPR double-opt-in verification email). Hostinger example:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_USER=noreply@justyeet.it
#   SMTP_PASS=your_password_here
#   SMTP_FROM=noreply@justyeet.it
# If SMTP_* are unset, verification tokens are created but no email is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public URL used in verification links (no trailing slash)
PUBLIC_BASE_URL=https://justyeet.it

# Post translation. Providers: azure (2M chars/month free, needs TRANSLATE_REGION),
# google (500k chars/month free), deepl (paid Growth plan), libretranslate (self-hosted).
# Leave TRANSLATE_PROVIDER empty to keep translation off (UI hides the button).
TRANSLATE_PROVIDER=azure
TRANSLATE_URL=
TRANSLATE_API_KEY=CHANGE_ME
TRANSLATE_REGION=germanywestcentral

# ── F6 sanctions screening of payout addresses (docs/sanktions-screening.md) ──
# on (default) | off. With "on", every payout target (linked wallet, conversion,
# batch mint) is checked against the list below; batch payouts are held until
# the list has loaded at least once.
SANCTIONS_SCREENING=on
# Newline-separated EVM addresses. Default: OFAC SDN digital-currency addresses
# (ETH-compatible) from the 0xB10C mirror; "none" = no remote list.
SANCTIONS_LIST_URL=
# Optional local list (newline-separated) and inline extras (comma-separated).
SANCTIONS_LIST_FILE=
SANCTIONS_EXTRA_ADDRESSES=
SANCTIONS_REFRESH_HOURS=24

# WalletConnect v2 (Reown) Cloud project id — free at https://cloud.reown.com.
# Empty = the WalletConnect button in the login dialog stays "coming soon".
WALLETCONNECT_PROJECT_ID=

# Points→YEET conversion rate is versioned in the DB (table conversion_rates,
# admin endpoint /api/v1/admin/conversion-rate). A change must be announced
# at least this many days before it applies (Terms §6 / docs/mica/09 D4).
YEET_RATE_NOTICE_DAYS=14
